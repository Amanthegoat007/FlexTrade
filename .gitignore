# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Node / web ---
node_modules/
flextrade-web/client/dist/
flextrade-web/client/dist-static/
.netlify/

# --- runtime artifacts (regenerated every pipeline run) ---
flextrade/logs/
flextrade/output/web/
*.log

# CI-collected snapshots ARE the data asset — never ignore them
!data/collected/
!data/collected/*.csv
# ...but the per-run status file is not data. It carries a timestamp, so if it
# lived inside data/collected it would change every tick, always stage, and
# defeat the empty-tick check that reads it.
data/_collector_status.json

# --- scratch ---
.DS_Store
Thumbs.db

# The SQLite store is a GENERATED artifact — rebuilt from scrapes by the
# pipeline, 110 MB and growing. It was tracked for months, crossed GitHub's
# 100 MB hard limit, and blocked every push. Never track it again.
flextrade/data/flextrade.db
flextrade/data/*.db-wal
flextrade/data/*.db-shm
